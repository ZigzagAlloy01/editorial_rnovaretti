<%- include('../partials/header') %>

<section class="auth-container">

    <h1>Crear cuenta</h1>

    <% if (error) { %>
        <div class="auth-error">
            <%= error %>
        </div>
    <% } %>

    <form method="POST" action="/register" class="auth-form">

        <div class="form-group">
            <label for="name">Nombre completo</label>
            <input
                type="text"
                id="name"
                name="name"
                required
            >
        </div>

        <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input
                type="email"
                id="email"
                name="email"
                required
            >
        </div>

        <div class="form-group">
            <label for="password">Contraseña</label>
            <input
                type="password"
                id="password"
                name="password"
                minlength="6"
                required
            >
        </div>

        <button type="submit">
            Crear cuenta
        </button>

    </form>

    <p class="auth-links">
        ¿Ya tienes cuenta?
        <a href="/login">
            Iniciar sesión
        </a>
    </p>

</section>

<%- include('../partials/footer') %>